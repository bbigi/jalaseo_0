@push('scripts')
<script>
let selectedMedia = null;

// Load WordPress categories when website selected
document.getElementById('websiteSelect').addEventListener('change', function() {
    const websiteId = this.value;
    const categoriesField = document.getElementById('categoriesField');
    const categoriesSelect = document.getElementById('categoriesSelect');

    if (!websiteId) {
        categoriesField.style.display = 'none';
        return;
    }

    categoriesField.style.display = 'block';
    categoriesSelect.innerHTML = '<option value="">Loading...</option>';

    fetch(`/websites/fetch-categories/${websiteId}`)
        .then(res => res.json())
        .then(data => {
            if (data.success && data.data && data.data.categories) {
                const categories = data.data.categories;

                if (categories.length === 0) {
                    categoriesSelect.innerHTML = '<option value="">No categories found</option>';
                    return;
                }

                categoriesSelect.innerHTML = '';

                categories.forEach(cat => {
                    const option = document.createElement('option');
                    option.value = cat.id;
                    option.textContent = cat.name;
                    categoriesSelect.appendChild(option);
                });
            } else {
                categoriesSelect.innerHTML = '<option value="">Failed to load categories</option>';
                console.error('Error loading categories:', data.message);
            }
        })
        .catch(error => {
            categoriesSelect.innerHTML = '<option value="">Error loading categories</option>';
            console.error('Fetch error:', error);
        });
});

// Publish Action Change
document.getElementById('publishActionSelect').addEventListener('change', function() {
    const scheduleField = document.getElementById('scheduleField');
    const helpText = this.parentElement.querySelector('.text-xs');

    scheduleField.classList.add('hidden');

    switch(this.value) {
        case 'save_only':
            helpText.textContent = 'Post will be saved locally only';
            break;
        case 'send_draft':
            helpText.textContent = 'Post will be sent to WordPress as draft';
            break;
        case 'publish_now':
            helpText.textContent = 'Post will be published immediately to WordPress';
            break;
        case 'schedule':
            helpText.textContent = 'Post will be scheduled for future publishing';
            scheduleField.classList.remove('hidden');
            break;
    }

    document.getElementById('publishAction').value = this.value;
});

// Media Modal Functions
function openMediaModal() {
    document.getElementById('mediaModal').classList.remove('hidden');
    loadMediaLibrary();
}

function closeMediaModal() {
    document.getElementById('mediaModal').classList.add('hidden');
    selectedMedia = null;
}

function switchMediaTab(tab) {
    document.querySelectorAll('.media-tab').forEach(btn => {
        btn.classList.remove('border-blue-600', 'text-blue-400');
        btn.classList.add('border-transparent', 'text-gray-400');
    });

    document.querySelector(`[data-tab="${tab}"]`).classList.add('border-blue-600', 'text-blue-400');
    document.querySelector(`[data-tab="${tab}"]`).classList.remove('border-transparent', 'text-gray-400');

    document.getElementById('tabLibrary').classList.add('hidden');
    document.getElementById('tabUpload').classList.add('hidden');
    document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.remove('hidden');
}

function loadMediaLibrary() {
    fetch('/media/api/list')
        .then(res => res.json())
        .then(data => {
            const grid = document.getElementById('mediaLibraryGrid');

            if (!data.success || !data.media || data.media.length === 0) {
                grid.innerHTML = '<div class="col-span-full text-center py-12 text-gray-400">No media found</div>';
                return;
            }

            grid.innerHTML = data.media.map(item => `
                <div class="rounded overflow-hidden border-2 border-gray-700 hover:border-blue-500 cursor-pointer transition-all"
                     onclick="selectMedia(${item.id}, '${item.full_url}', '${item.title || item.file_name}')">
                    <div class="relative aspect-square bg-gray-900">
                        <img src="${item.full_url}"
                             alt="${item.alt_text || item.file_name}"
                             class="absolute inset-0 w-full h-full object-cover">
                    </div>
                </div>
            `).join('');
        })
        .catch(err => {
            console.error('Failed to load media:', err);
            document.getElementById('mediaLibraryGrid').innerHTML = '<div class="col-span-full text-center py-12 text-red-400">Error loading media</div>';
        });
}

function selectMedia(id, url, title) {
    selectedMedia = { id, url, title };

    document.querySelectorAll('#mediaLibraryGrid > div').forEach(el => {
        el.classList.remove('border-blue-500');
        el.classList.add('border-transparent');
    });

    event.currentTarget.classList.remove('border-transparent');
    event.currentTarget.classList.add('border-blue-500');

    document.getElementById('selectedMediaInfo').textContent = `Selected: ${title}`;
}

function setFeaturedImage() {
    if (!selectedMedia) {
        alert('Please select a media file');
        return;
    }

    document.getElementById('featuredMediaId').value = selectedMedia.id;
    document.getElementById('featuredImageThumb').src = selectedMedia.url;
    document.getElementById('featuredImagePreview').classList.remove('hidden');

    closeMediaModal();
}

function removeFeaturedImage() {
    document.getElementById('featuredMediaId').value = '';
    document.getElementById('featuredImagePreview').classList.add('hidden');
}

function handleMediaUpload(event) {
    const file = event.target.files[0];
    if (!file) return;
    uploadFile(file);
}

function uploadFile(file) {
    // Validate file type
    if (!file.type.startsWith('image/')) {
        alert('Please select an image file');
        return;
    }

    // Validate file size (10 MB)
    if (file.size > 10 * 1024 * 1024) {
        alert('File size must be less than 10 MB');
        return;
    }

    const formData = new FormData();
    formData.append('media_file', file);
    formData.append('_token', '{{ csrf_token() }}');

    // Show progress
    document.getElementById('uploadProgress').classList.remove('hidden');
    document.getElementById('uploadProgressBar').style.width = '0%';
    document.getElementById('uploadStatus').textContent = 'Uploading...';

    fetch('/media/upload', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        },
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        document.getElementById('uploadProgressBar').style.width = '100%';
        document.getElementById('uploadStatus').textContent = 'Upload complete!';

        setTimeout(() => {
            document.getElementById('uploadProgress').classList.add('hidden');
            if (data.success) {
                loadMediaLibrary();
                switchMediaTab('library');
            }
        }, 1000);
    })
    .catch(error => {
        document.getElementById('uploadProgressBar').style.width = '100%';
        document.getElementById('uploadProgressBar').classList.add('bg-red-600');
        document.getElementById('uploadStatus').textContent = 'Upload failed: ' + error.message;

        setTimeout(() => {
            document.getElementById('uploadProgress').classList.add('hidden');
            document.getElementById('uploadProgressBar').classList.remove('bg-red-600');
        }, 3000);
    });
}

// Drag and Drop functionality
const dropZone = document.getElementById('dropZone');

dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-blue-500', 'bg-gray-700');
});

dropZone.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-blue-500', 'bg-gray-700');
});

dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-blue-500', 'bg-gray-700');

    const files = e.dataTransfer.files;
    if (files.length > 0) {
        uploadFile(files[0]);
    }
});

// Insight Autocomplete
const insightSearch = document.getElementById('insightSearch');
const insightDropdown = document.getElementById('insightDropdown');
const insightId = document.getElementById('insightId');
const selectedInsight = document.getElementById('selectedInsight');
const insights = @json($insights);

insightSearch.addEventListener('input', function() {
    const query = this.value.toLowerCase();

    if (!query) {
        insightDropdown.classList.add('hidden');
        return;
    }

    const filtered = insights.filter(i => i.topic.toLowerCase().includes(query));

    if (filtered.length === 0) {
        insightDropdown.innerHTML = '<div class="p-2 text-xs text-gray-400">No results</div>';
        insightDropdown.classList.remove('hidden');
        return;
    }

    insightDropdown.innerHTML = filtered.map(i => `
        <div class="p-2 hover:bg-gray-800 cursor-pointer text-sm" onclick="selectInsight(${i.id}, '${i.topic.replace(/'/g, "\\'")}')">
            ${i.topic}
        </div>
    `).join('');
    insightDropdown.classList.remove('hidden');
});

function selectInsight(id, topic) {
    insightId.value = id;
    insightSearch.value = topic;
    selectedInsight.textContent = topic;
    insightDropdown.classList.add('hidden');
}

document.addEventListener('click', function(e) {
    if (!e.target.closest('#insightSearch') && !e.target.closest('#insightDropdown')) {
        insightDropdown.classList.add('hidden');
    }
});
</script>
@endpush
@endsection
